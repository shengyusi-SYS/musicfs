{
  "name": "musicfs",
  "main": "dist/worker/worker.mjs",
  "no_bundle": true,
  "find_additional_modules": true,
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "rules": [
    { "type": "ESModule", "globs": ["*.mjs", "plugins/**/*.mjs", "plugins/**/*.js"], "fallthrough": false },
    { "type": "Text", "globs": ["plugins/**/*.json", "plugins/**/*.txt", "plugins/**/*.md"], "fallthrough": false }
  ],
  "assets": { "directory": "./dist/web", "binding": "ASSETS", "run_worker_first": ["/api/*", "/dav", "/dav/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "musicfs", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "src/infrastructure/persistence/migrations" }],
  "secrets": { "required": ["ADMIN_TOKEN", "DAV_USERNAME", "DAV_PASSWORD", "CF_API_TOKEN"] }
}
