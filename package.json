{
  "name": "musicfs",
  "version": "0.1.0-dev.28",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json && tsc --project tsconfig.web.json",
    "check": "bun run build:sample && bun run build:qq && bun run build:netease && bun run typecheck && bun run check:boundaries && bun test",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs src packages plugins tests",
    "test": "bun test",
    "build:sample": "bun run scripts/build-sample.ts",
    "probe:compiled": "bun run scripts/probe-compiled.ts",
    "probe:worker": "bun run scripts/probe-worker.ts",
    "probe:worker:dav": "bun run scripts/probe-worker-dav.ts",
    "probe:rclone": "bun run scripts/probe-rclone.ts",
    "fetch:rclone:linux": "bun run scripts/fetch-rclone-linux.ts",
    "dev:web": "vite",
    "dev:service": "bun run scripts/dev-desktop.ts",
    "build:web": "vite build",
    "probe:worker:authentication": "bun run scripts/probe-worker-authentication.ts",
    "build:auth-fixture": "bun run scripts/build-auth-fixture.ts",
    "build:qq": "bun run scripts/build-qq.ts",
    "probe:worker:qq": "bun run scripts/probe-worker-qq.ts",
    "build:netease": "bun run scripts/build-netease.ts",
    "probe:worker:netease": "bun run scripts/probe-worker-netease.ts",
    "build:worker": "bun run scripts/build-worker.ts",
    "probe:worker:service": "bun run scripts/probe-worker-service.ts",
    "build:desktop": "bun run scripts/build-desktop.ts",
    "build:author-kit": "bun run scripts/build-author-kit.ts",
    "package:release": "bun run scripts/package-release.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@hono/bun": "1.0.1",
    "@musicfs/plugin-api": "workspace:*",
    "@rjsf/antd": "6.11.0",
    "@rjsf/core": "6.11.0",
    "@rjsf/utils": "6.11.0",
    "@rjsf/validator-ajv8": "6.11.0",
    "@tanstack/react-query": "5.104.5",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "2.24.0",
    "antd": "6.6.6",
    "better-auth": "1.7.12",
    "cloudflare": "7.3.0",
    "croner": "10.0.1",
    "dayjs": "1.11.23",
    "env-paths": "4.0.0",
    "fast-deep-equal": "3.1.3",
    "hono": "4.13.13",
    "lru-cache": "11.5.3",
    "mustache": "4.2.0",
    "open": "11.0.4",
    "proper-lockfile": "4.1.2",
    "range-parser": "1.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "sanitize-filename": "1.6.4",
    "selfsigned": "5.5.0",
    "semver": "7.8.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/bun": "1.4.3",
    "@types/mustache": "4.2.6",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/range-parser": "1.2.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.6.0",
    "fflate": "0.8.3",
    "miniflare": "4.20260730.0",
    "music-metadata": "12.2.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "license": "GPL-3.0-only"
}
