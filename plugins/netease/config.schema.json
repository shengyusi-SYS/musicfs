{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": { "type": "string", "title": "目录名称", "minLength": 1, "maxLength": 80, "default": "网易云音乐" },
    "metadataCacheDays": { "type": "integer", "title": "音乐资料缓存天数", "minimum": 0, "default": 365,
      "description": "封面、歌词等资料的保留天数，0 表示长期保留。修改后用于新获取的资料，缺失结果最多保留 30 天。需要更新时可在目录菜单重新获取。" },
    "quality": {
      "type": "string", "title": "单版本目标音质", "default": "standard",
      "oneOf": [
        { "const": "hires", "title": "Hi-Res" }, { "const": "lossless", "title": "无损" },
        { "const": "exhigh", "title": "极高" }, { "const": "standard", "title": "标准" }
      ]
    },
    "audio": {
      "type": "object", "title": "音频版本", "additionalProperties": false,
      "description": "单版本每首保留一个文件，多版本按所选音质分别显示。可用音质取决于当前账号，仅导出完整歌曲。",
      "default": { "mode": "single", "qualities": ["standard"], "missingQuality": "hide" },
      "required": ["mode", "qualities", "missingQuality"],
      "properties": {
        "mode": { "type": "string", "title": "导出模式", "default": "single", "oneOf": [
          { "const": "single", "title": "单版本" }, { "const": "multiple", "title": "多版本" }
        ] },
        "qualities": { "type": "array", "title": "多版本目标音质", "minItems": 1, "maxItems": 4, "uniqueItems": true, "default": ["standard"], "items": { "type": "string", "oneOf": [
          { "const": "hires", "title": "Hi-Res" }, { "const": "lossless", "title": "无损" },
          { "const": "exhigh", "title": "极高" }, { "const": "standard", "title": "标准" }
        ] } },
        "missingQuality": { "type": "string", "title": "目标音质缺失", "description": "所选音质不可用时，可隐藏该版本，或按 Hi-Res、无损、极高、标准的顺序向下尝试。", "default": "hide", "oneOf": [
          { "const": "hide", "title": "隐藏缺失版本" }, { "const": "fallback", "title": "自动回退到较低音质" }
        ] }
      }
    }
  }
}
