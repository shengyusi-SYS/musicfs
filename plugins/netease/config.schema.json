{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "label": { "type": "string", "title": "目录名称", "minLength": 1, "maxLength": 80, "default": "网易云音乐" },
    "metadataCacheDays": { "type": "integer", "title": "音乐资料缓存天数", "minimum": 0, "default": 7,
      "description": "封面、歌词和补充音乐资料的保留天数；0 表示长期保留。空或缺失结果仍在 1 天后重试，不影响播放地址和歌单名单更新。" },
    "quality": {
      "type": "string", "title": "单版本目标音质", "default": "standard",
      "description": "只在单版本模式生效；多版本模式使用下方的多版本目标音质。",
      "oneOf": [
        { "const": "hires", "title": "Hi-Res" }, { "const": "lossless", "title": "无损" },
        { "const": "exhigh", "title": "极高" }, { "const": "standard", "title": "标准" }
      ]
    },
    "audio": {
      "type": "object", "title": "音频版本", "additionalProperties": false,
      "description": "按当前账号提供的完整版本导出。当前适配支持 Hi-Res、无损、极高和标准；回退依此顺序向下查找，不使用试听，不切换账号或歌曲。",
      "default": { "mode": "single", "qualities": ["standard"], "missingQuality": "hide" },
      "required": ["mode", "qualities", "missingQuality"],
      "properties": {
        "mode": { "type": "string", "title": "导出模式", "default": "single", "oneOf": [
          { "const": "single", "title": "单版本" }, { "const": "multiple", "title": "多版本" }
        ] },
        "qualities": { "type": "array", "title": "多版本目标音质", "description": "只在多版本模式生效。单版本模式使用上方的单版本目标音质。", "minItems": 1, "maxItems": 4, "uniqueItems": true, "default": ["standard"], "items": { "type": "string", "oneOf": [
          { "const": "hires", "title": "Hi-Res" }, { "const": "lossless", "title": "无损" },
          { "const": "exhigh", "title": "极高" }, { "const": "standard", "title": "标准" }
        ] } },
        "missingQuality": { "type": "string", "title": "目标音质缺失", "default": "hide", "oneOf": [
          { "const": "hide", "title": "隐藏缺失版本" }, { "const": "fallback", "title": "自动回退到较低音质" }
        ] }
      }
    }
  }
}
